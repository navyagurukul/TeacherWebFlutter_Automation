# Copy to .env and adjust for your machine. Values here are the defaults.

# Site under test.
BASE_URL=https://teacher.englishgurukul.in/

# chrome | edge | firefox. Selenium Manager fetches the matching driver, so
# there is no chromedriver to install or keep in sync.
BROWSER=chrome

# true = run without a visible window. The portal is CanvasKit/WebGL, so the
# headless flags in config/browser_options.py keep software GL available; a
# headless run without them paints nothing and every locator times out.
HEADLESS=false

# Viewport. 1440x900 gives the desktop layout; try 420x900 for the phone layout.
WINDOW_WIDTH=1440
WINDOW_HEIGHT=900

# Waits, in seconds.
#   DEFAULT_TIMEOUT    a label/button appearing on an already-loaded screen
#   APP_LOAD_TIMEOUT   Flutter engine boot + first paint
#   DATA_LOAD_TIMEOUT  screens that fetch from the API before rendering
DEFAULT_TIMEOUT=20
APP_LOAD_TIMEOUT=60
DATA_LOAD_TIMEOUT=45

# Slack Incoming Webhook URL for the daily report (run_daily.py). Create one at
# https://api.slack.com/messaging/webhooks and paste it here.
SLACK_WEBHOOK_URL=

# Override the version shown in the report; blank = auto
# (login-screen footer -> version.json).
APP_VERSION=
